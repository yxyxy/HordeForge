{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hordeforge.local/schemas/context.code_patch.v1.schema.json",
  "title": "Code Patch Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "2.0"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "diff"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "change_type": {
            "type": "string",
            "enum": ["create", "modify", "delete"]
          },
          "diff": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "patch_text": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["edit", "write"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "old_string": {
            "type": "string"
          },
          "new_string": {
            "type": "string"
          },
          "replace_all": {
            "type": "boolean"
          },
          "content": {
            "type": "string"
          },
          "change_type": {
            "type": "string",
            "enum": ["create", "modify", "delete"]
          }
        }
      }
    },
    "test_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["edit", "write"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "old_string": {
            "type": "string"
          },
          "new_string": {
            "type": "string"
          },
          "replace_all": {
            "type": "boolean"
          },
          "content": {
            "type": "string"
          },
          "change_type": {
            "type": "string",
            "enum": ["create", "modify", "delete"]
          }
        }
      }
    },
    "test_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "diff"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "change_type": {
            "type": "string",
            "enum": ["create", "modify", "delete"]
          },
          "diff": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dry_run": {
      "type": "boolean"
    },
    "expected_failures": {
      "type": "integer",
      "minimum": 0
    },
    "fix_iteration": {
      "type": "integer",
      "minimum": 1
    },
    "remaining_failures": {
      "type": "integer",
      "minimum": 0
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "pr_url": {
      "type": "string",
      "minLength": 1
    },
    "branch_name": {
      "type": "string",
      "minLength": 1
    },
    "applied_to_github": {
      "type": "boolean"
    },
    "apply_error": {
      "type": "string"
    },
    "rollback_performed": {
      "type": "boolean"
    },
    "llm_enhanced": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
